# Copy this file to .env.local to change where the editor sends sentences.
# Ollama's address, without /v1. `npm run dev` reaches it through Vite's proxy;
# `npm run preview` connects directly, so Ollama must allow the page's origin.
VITE_OLLAMA_SERVER_URL=http://127.0.0.1:11434
# The model that checks your sentences. Pull it first: ollama pull gemma4:e4b
VITE_OLLAMA_MODEL=gemma4:e4b
